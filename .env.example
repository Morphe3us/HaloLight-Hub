# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/halolight_hub
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional frontend
VITE_CLERK_PROXY_URL=
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional server
# Hosting: platform PORT is supplied by Infomaniak. Use HTTPS origins in production.
# FRONTEND_DIST_PATH defaults to artifacts/halolight-os/dist/public from the repository root.
FRONTEND_DIST_PATH=
APP_PUBLIC_URL=http://localhost:18205
API_ALLOWED_ORIGINS=http://localhost:18205
LOG_LEVEL=info
STORAGE_PROVIDER=
ALLOW_PUBLIC_SIGNUPS=
ENABLE_COMMUNITY=
BUNNY_PLAYBACK_SECURITY_CONFIRMED=
RUN_DB_PUSH_ON_POST_MERGE=
SEED_ADMIN_CLERK_ID=
SEED_ADMIN_EMAIL=
SEED_BASE_DATE=
SEED_DEMO_ACADEMY=
SEED_DEMO_DATA=

# Optional AI provider
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional Bunny Stream
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
# Embed view token authentication key (Stream > library > Security), server only.
BUNNY_STREAM_TOKEN_AUTH_KEY=
# Optional account API key for read-only library security diagnostics, server only.
BUNNY_API_KEY=

# Optional frontend launch flags
VITE_ALLOW_PUBLIC_SIGNUPS=
